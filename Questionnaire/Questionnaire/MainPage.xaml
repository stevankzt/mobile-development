<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Questionnaire.MainPage"
             Title="Анкета гостя кофейни">

    <!-- ScrollView: на маленьком экране все поля остаются доступными -->
    <ScrollView>
        <!-- Корневой Grid с явными строками и столбцами, Padding у контейнера -->
        <Grid x:Name="RootGrid"
              Padding="20"
              RowSpacing="12"
              ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />   <!-- 0 картинка -->
                <RowDefinition Height="Auto" />   <!-- 1 заголовок -->
                <RowDefinition Height="Auto" />   <!-- 2 контакты -->
                <RowDefinition Height="Auto" />   <!-- 3 напиток и частота -->
                <RowDefinition Height="Auto" />   <!-- 4 дата визита -->
                <RowDefinition Height="Auto" />   <!-- 5 оценка -->
                <RowDefinition Height="Auto" />   <!-- 6 чекбоксы -->
                <RowDefinition Height="Auto" />   <!-- 7 отзыв -->
                <RowDefinition Height="Auto" />   <!-- 8 кнопки -->
                <RowDefinition Height="Auto" />   <!-- 9 результат -->
            </Grid.RowDefinitions>

            <!-- Image -->
            <Image Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
                   Source="coffee.png"
                   Aspect="AspectFit"
                   HeightRequest="140"
                   Margin="0,0,0,8" />

            <!-- Label: заголовок и подсказка -->
            <VerticalStackLayout Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                 Spacing="4">
                <Label Text="Анкета гостя кофейни"
                       FontSize="26"
                       FontAttributes="Bold"
                       HorizontalTextAlignment="Center" />
                <Label Text="Поля со звёздочкой (*) обязательны"
                       FontSize="14"
                       FontAttributes="Italic"
                       HorizontalTextAlignment="Center"
                       TextColor="Gray" />
            </VerticalStackLayout>

            <!-- Контакты: два Entry с разными Keyboard + Switch, управляющий видимостью email -->
            <VerticalStackLayout Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                                 Spacing="8">
                <Label Text="Ваше имя *"
                       FontSize="16"
                       FontAttributes="Bold" />
                <Entry x:Name="NameEntry"
                       Placeholder="Например, Анна"
                       Keyboard="Text"
                       MaxLength="30"
                       TextChanged="OnFormChanged" />

                <HorizontalStackLayout Spacing="10" Margin="0,4,0,0">
                    <Switch x:Name="NewsletterSwitch"
                            IsToggled="False"
                            OnColor="SaddleBrown"
                            Toggled="OnNewsletterToggled" />
                    <Label Text="Получать новости и акции"
                           FontSize="16"
                           FontAttributes="None"
                           VerticalTextAlignment="Center" />
                </HorizontalStackLayout>

                <!-- Появляется только при включённом Switch (IsVisible меняется в коде) -->
                <Entry x:Name="EmailEntry"
                       Placeholder="Email для рассылки *"
                       Keyboard="Email"
                       MaxLength="50"
                       IsVisible="False"
                       TextChanged="OnFormChanged" />
            </VerticalStackLayout>

            <!-- Picker в левом столбце -->
            <VerticalStackLayout Grid.Row="3" Grid.Column="0"
                                 Spacing="8">
                <Label Text="Любимый напиток *"
                       FontSize="16"
                       FontAttributes="Bold" />
                <Picker x:Name="DrinkPicker"
                        Title="Выберите напиток"
                        SelectedIndexChanged="OnFormChanged">
                    <Picker.ItemsSource>
                        <x:Array Type="{x:Type x:String}">
                            <x:String>Эспрессо</x:String>
                            <x:String>Капучино</x:String>
                            <x:String>Латте</x:String>
                            <x:String>Раф</x:String>
                            <x:String>Чай</x:String>
                        </x:Array>
                    </Picker.ItemsSource>
                </Picker>
            </VerticalStackLayout>

            <!-- RadioButton: три варианта в одной группе, правый столбец -->
            <VerticalStackLayout Grid.Row="3" Grid.Column="1"
                                 Spacing="2">
                <Label Text="Как часто бываете?"
                       FontSize="16"
                       FontAttributes="Bold" />
                <RadioButton x:Name="VisitFirstRadio"
                             Content="Впервые"
                             GroupName="VisitFrequency"
                             Value="Впервые" />
                <RadioButton x:Name="VisitMonthlyRadio"
                             Content="Раз в месяц"
                             GroupName="VisitFrequency"
                             Value="Раз в месяц" />
                <RadioButton x:Name="VisitWeeklyRadio"
                             Content="Каждую неделю"
                             GroupName="VisitFrequency"
                             Value="Каждую неделю" />
            </VerticalStackLayout>

            <!-- DatePicker: начальная дата внутри диапазона -->
            <VerticalStackLayout Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2"
                                 Spacing="8">
                <Label Text="Дата визита"
                       FontSize="16"
                       FontAttributes="Bold" />
                <DatePicker x:Name="VisitDatePicker"
                            Format="dd.MM.yyyy"
                            Date="10/01/2026"
                            MinimumDate="01/01/2025"
                            MaximumDate="12/31/2026" />
            </VerticalStackLayout>

            <!-- Slider + привязка через x:Reference с явными Path и Mode -->
            <VerticalStackLayout Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2"
                                 Spacing="4">
                <Label x:DataType="Slider"
                       Text="{Binding Source={x:Reference RatingSlider},
                                      Path=Value,
                                      Mode=OneWay,
                                      StringFormat='Оценка обслуживания: {0:F0} из 10'}"
                       FontSize="16"
                       FontAttributes="Bold" />
                <Slider x:Name="RatingSlider"
                        Minimum="1"
                        Maximum="10"
                        Value="7"
                        MinimumTrackColor="SaddleBrown" />
            </VerticalStackLayout>

            <!-- Два CheckBox в двух столбцах -->
            <HorizontalStackLayout Grid.Row="6" Grid.Column="0"
                                   Spacing="4">
                <CheckBox x:Name="DessertCheckBox"
                          IsChecked="False"
                          Color="SaddleBrown" />
                <Label Text="Брал(а) десерт"
                       FontSize="15"
                       VerticalTextAlignment="Center" />
            </HorizontalStackLayout>
            <HorizontalStackLayout Grid.Row="6" Grid.Column="1"
                                   Spacing="4">
                <CheckBox x:Name="RecommendCheckBox"
                          IsChecked="True"
                          Color="SaddleBrown" />
                <Label Text="Посоветую друзьям"
                       FontSize="15"
                       VerticalTextAlignment="Center" />
            </HorizontalStackLayout>

            <!-- Editor -->
            <VerticalStackLayout Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="2"
                                 Spacing="8">
                <Label Text="Ваш отзыв"
                       FontSize="16"
                       FontAttributes="Bold" />
                <Editor x:Name="ReviewEditor"
                        Placeholder="Что понравилось, что можно улучшить?"
                        AutoSize="TextChanges"
                        MaxLength="300"
                        MinimumHeightRequest="80" />
            </VerticalStackLayout>

            <!-- «Показать результат» неактивна, пока не заполнены обязательные поля -->
            <Button x:Name="ShowResultButton"
                    Grid.Row="8" Grid.Column="0"
                    Text="Показать результат"
                    BackgroundColor="SaddleBrown"
                    TextColor="White"
                    IsEnabled="False"
                    Margin="0,8,0,0"
                    Clicked="OnShowResultClicked" />
            <Button x:Name="ClearButton"
                    Grid.Row="8" Grid.Column="1"
                    Text="Очистить"
                    BackgroundColor="Gray"
                    TextColor="White"
                    Margin="0,8,0,0"
                    Clicked="OnClearClicked" />

            <!-- Сводка ответов, скрыта до нажатия «Показать результат» -->
            <Border x:Name="ResultBorder"
                    Grid.Row="9" Grid.Column="0" Grid.ColumnSpan="2"
                    IsVisible="False"
                    Padding="12"
                    Margin="0,8,0,0"
                    Stroke="SaddleBrown"
                    StrokeThickness="1">
                <Label x:Name="ResultLabel"
                       FontSize="15" />
            </Border>
        </Grid>
    </ScrollView>

</ContentPage>
